# Twitter API (optional - app works without it using demo data)
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Database
DATABASE_URL=sqlite+aiosqlite:///./sentiment_history.db

# CORS - add your deployed frontend URL here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# Model cache directory
MODEL_CACHE_DIR=./model_cache

# Logging
LOG_LEVEL=INFO
